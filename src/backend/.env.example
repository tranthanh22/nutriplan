NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Project URL and publishable key are safe for browser/user-scoped clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional until the AI endpoint is enabled.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2

# Stripe Checkout (server only). Use test keys for local/MVP testing.
FRONTEND_URL=http://localhost:3000
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
