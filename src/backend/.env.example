NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Project URL and publishable key are safe for browser/user-scoped clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=sb_secret_xxx

# AI Insight và Trợ lý ảo Gemini (server only). Lấy key tại Google AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000

# Stripe Checkout (server only). Use test keys for local/MVP testing.
FRONTEND_URL=http://localhost:3000
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Không bắt buộc: nếu để trống backend tự tạo cấu hình Customer Portal ở lần mở đầu.
STRIPE_PORTAL_CONFIGURATION_ID=
